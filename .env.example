# ShiftFix environment variables.
# Copy to .env.local — never commit secrets.

# ── AI provider ───────────────────────────────────────────────────────────────
# bob     → IBM Bob inference (bob.ibm.com)
# watsonx → IBM Granite on watsonx.ai
# rules   → keyword/regex fallback (no network; default for CI / offline demos)
AI_PROVIDER=rules

# Cap remote model calls per serverless isolate / process (default 60)
AI_MAX_CALLS_PER_SESSION=60

# ── IBM Bob inference ─────────────────────────────────────────────────────────
BOB_API_KEY=            # required for AI_PROVIDER=bob (Inference or General key)
BOB_TEAM_ID=            # optional — only for General keys (Inference keys omit this)
BOB_INFERENCE_URL=https://api.us-east.bob.ibm.com/inference/v1/chat/completions
BOB_MODEL_ID=premium    # Bob aliases: premium | fast | ultra | …

# ── watsonx.ai (optional alternative) ─────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# ── Supabase (preferred on Vercel for durable demo state) ─────────────────────
# If unset, the app uses server memory + browser localStorage so local demos still work.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Aliases still accepted if you already use the Next public names:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
