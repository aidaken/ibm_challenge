# ShiftFix — written by IBM Bob
# Copy to .env.local (never commit secrets).

# AI: watsonx | ollama | mock (mock keeps the demo green offline)
AI_PROVIDER=mock

# watsonx.ai (IBM Granite)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2024-05-29
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Ollama local Granite fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite3.3:8b

# Optional Supabase (demo uses in-memory store if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
